# ---- Core ----
# HTTP port for the REST API + web dashboard
PORT=3000
# Where the SQLite database lives (created automatically)
DB_PATH=./data/opsly.db
# Optional bearer token protecting the REST API + web dashboard.
# If unset, the API is open (fine for a trusted internal network, not the internet).
API_TOKEN=
# Base URL used in links inside Slack messages (your dashboard URL)
BASE_URL=http://localhost:3000

# ---- Slack (all three required to enable the Slack integration) ----
# Bot token (xoxb-...), from OAuth & Permissions after installing the app
SLACK_BOT_TOKEN=
# App-level token (xapp-...) with connections:write scope, for Socket Mode
SLACK_APP_TOKEN=
# Signing secret, from Basic Information
SLACK_SIGNING_SECRET=
# Optional: fallback channel ID for incident posts when a service has no channel configured
SLACK_DEFAULT_CHANNEL=

# ---- Engine ----
# How often the escalation engine scans for overdue incidents (seconds)
ESCALATION_SWEEP_SECONDS=15

# ---- Serverless / ephemeral hosts (see README "Deploy to Vercel") ----
# Extra bearer token accepted only by GET/POST /api/v1/escalation-sweep, so an
# external scheduler can drive escalations. Vercel Cron sends it automatically
# when the project has a CRON_SECRET environment variable.
CRON_SECRET=
# Set to 1 to (re)create the demo dataset at startup — useful where the
# database starts empty on every boot. Safe: skips anything already present.
SEED_ON_START=
