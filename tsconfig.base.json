{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@opsly/core": ["packages/core/src/index.ts"],
      "@opsly/core/*": ["packages/core/src/*"],
      "@opsly/db": ["packages/db/src/index.ts"],
      "@opsly/db/*": ["packages/db/src/*"],
      "@opsly/integrations": ["packages/integrations/src/index.ts"],
      "@opsly/integrations/*": ["packages/integrations/src/*"]
    }
  }
}
