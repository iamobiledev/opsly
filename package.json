{
  "name": "opsly",
  "version": "0.1.0",
  "description": "Self-hosted PagerDuty-style incident management and on-call rotations, managed from Slack",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "vercel-build": "echo 'No build step: Vercel bundles api/index.ts directly'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@slack/bolt": "^4.2.0",
    "@slack/web-api": "^7.18.0",
    "express": "^5.1.0",
    "luxon": "^3.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
